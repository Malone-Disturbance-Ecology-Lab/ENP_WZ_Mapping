    "def calculate_accuracy_target_year(common_df1, coord_pred, y_pred):\n",
    "    ################## Evaluate the prediction accuracy for the target year #####################\n",
    "    # Step 1: Find matching coordinates between coord_pred and common_df1\n",
    "    common_coords = common_df1[:, :2]  # Extract lat, lon from common_df1\n",
    "\n",
    "    # Find indices where coord_pred exists in common_coords\n",
    "    matching_indices = [i for i, coord in enumerate(coord_pred) if any(np.all(coord == common_coords[j]) for j in range(common_coords.shape[0]))]\n",
    "\n",
    "    # Step 2: Get y values from common_df1 based on matching indices\n",
    "    y_true = np.array([common_df1[np.where((common_coords == coord_pred[i]).all(axis=1))[0][0], 2] for i in matching_indices])\n",
    "\n",
    "    # Step 3: Get subset of y_pred for matching coordinates\n",
    "    y_pred_subset = y_pred[matching_indices]\n",
    "\n",
    "    # Step 4: Compute overall accuracy (Mean Absolute Error or % Accuracy)\n",
    "    accuracy = np.mean(y_pred_subset == y_true) * 100 \n",
    "\n",
    "    # Output results\n",
    "\n",
    "    print(f\"Accuracy of the predicted values compared to the consistency points between two cal years: {accuracy:.1f}%\")\n",
    "    return np.round(accuracy,1)"
   ]
