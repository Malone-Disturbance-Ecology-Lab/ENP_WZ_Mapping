    "# Build a KDTree for nearest-neighbor search\n",
    "tree = KDTree(coords)\n",
    "\n",
    "# Create an empty raster\n",
    "raster = np.empty((rows, cols), dtype=np.float32)\n",
    "raster.fill(np.nan)\n",
    "\n",
    "# Iterate over the raster grid\n",
    "x_coords = np.linspace(xmin + pixel_size / 2, xmax - pixel_size / 2, cols)\n",
    "y_coords = np.linspace(ymax - pixel_size / 2, ymin + pixel_size / 2, rows)\n",
    "for i, y in enumerate(y_coords):\n",
    "    for j, x in enumerate(x_coords):\n",
    "        # Find the nearest point\n",
    "        _, idx = tree.query((x, y))\n",
    "        raster[i, j] = values[idx]\n",
    "\n",
    "# Save the raster\n",
