    "def count_non_nan_values(array):\n",
    "        \"\"\"Counts non-NaN values in an array while ignoring non-numeric elements.\"\"\"\n",
    "        # Filter to keep only numeric data (e.g., ints and floats)\n",
    "        numeric_values = [x for x in array if isinstance(x, (int, float))] \n",
    "        # Convert to NumPy array and count non-NaN values\n",
    "        return np.sum(~np.isnan(np.array(numeric_values, dtype=float)))\n",
    "    \n",
    "def data_prep(path, file, cutoff=0, direction=0, cutlon=0, sensor = 1):\n",
    "    ####### filter the data with 015042 index ######\n",
    "    df = pd.read_csv(path + file)\n",
    "    df['ID'] = range(0, len(df))  # Generates IDs starting from 1\n",
    "    \n",
    "    if sensor == 0:\n",
    "        training_data = df[['lat', 'lon', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7', 'ndmi', 'ndvi', 'savi', 'descriptio']].to_numpy()\n",
    "    else:\n",
    "        training_data = df[['lat', 'lon', 'SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ndmi', 'ndvi', 'savi', 'descriptio']].to_numpy()\n",
    "    \n",
    "    predictor = []\n",
    "    target = []\n",
    "    coord = []\n",
    "    # Loop through each (1585, 10) array in training_data\n",
    "    print('training data is:')\n",
    "    #print(training_data)\n",
    "    print(training_data.shape)\n",
    "    #for array in training_data:\n",
    "        # Get rows where the target is not 'TZ'\n",
    "    mask = training_data[:, 11] != 'MZ'\n",
    "    \n",
    "    predictor.append(training_data[mask, 2:11])  # First 9 columns\n",
    "    target.append(training_data[mask, 11])       # Target column\n",
    "    coord.append(training_data[mask, :2])\n",
    "    \n",
    "    # Convert to NumPy arrays if desired\n",
    "    predictor = np.array(predictor)\n",
    "    target = np.array(target)\n",
    "    coord = np.array(coord)\n",
    "    \n",
    "    X = predictor.reshape(-1, 9)  # Shape: (5 * 1585, 9)\n",
    "    y = target.reshape(-1)        # Shape: (5 * 1585,)\n",
    "    coord = coord.reshape(-1, 2)\n",
    "    ### cleanse the data by removing nan ####\n",
    "    valid_indices = []\n",
    "\n",
    "    # Loop through each row and check for NaN in the first column\n",
    "    for i in range(X.shape[0]):\n",
    "        if not np.isnan(X[i, 0]):\n",
    "            valid_indices.append(i)\n",
    "    \n",
    "    # Create new X and y with only valid rows\n",
    "    X = X[valid_indices]\n",
    "    y = y[valid_indices]\n",
    "    coord = coord[valid_indices]\n",
    "\n",
    "    print('the size of dataset is:')\n",
    "    print(X.shape[0])\n",
    "\n",
    "    if cutoff:\n",
    "        if direction > 0: ### keep the eastern side\n",
    "            masklon = coord[:, 1] > cutlon\n",
    "        else:\n",
    "            masklon = coord[:, 1] <= cutlon\n",
    "    \n",
    "        X = X[masklon]\n",
    "        y = y[masklon]\n",
    "        coord = coord[masklon]\n",
    "    \n",
    "        print('the size of lon filtered dataset is:')\n",
    "        print(X.shape[0])\n",
    "        #print(X)\n",
    "    \n",
    "    return X, y, coord"
   ]
