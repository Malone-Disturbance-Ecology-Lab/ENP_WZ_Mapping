    "\n",
    "with rasterio.open(raster_path) as src:\n",
    "    raster_data = src.read(1)  # Read the first band (assuming single-band raster)\n",
    "    transform = src.transform  # Get affine transform\n",
    "\n",
    "    # Extract raster values at given coordinates\n",
    "    values = []\n",
    "    for x, y in coords:\n",
    "        row, col = rowcol(transform, x, y)  # Convert world coordinates to row/col indices\n",
    "        value = raster_data[row, col]  # Extract the raster value\n",
    "        values.append(value)\n",
    "\n",
    "values = np.array(values, dtype=float)  # Use float to allow NaN handling\n",
    "\n",
    "# Define mapping: 1 → 3, 2 → 1, 3 → 2\n",
    "mapping = {1: 3, 2: 1, 3: 2}\n",
    "\n",
    "# Function to safely map values\n",
    "def safe_map(val):\n",
    "    if val in mapping:\n",
    "        return mapping[val]\n",
    "    return val  # Keep original value (e.g., NaN, None)\n",
    "\n",
    "# Apply mapping with handling for NaN/None\n",
    "mapped_values = np.vectorize(safe_map)(values)\n",
    "\n",
    "# Print the modified values\n",
    "print(mapped_values)"
