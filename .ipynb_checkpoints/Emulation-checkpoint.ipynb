    "def model_across_years(X, y, X_test, y_test, coord_test):\n",
    "    model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
    "    model.fit(X, y)\n",
    "    score = model.score(X_test, y_test)\n",
    "    print(f\"Testing across years, accuracy is: {score*100:.2f}%\")\n",
    "    y_pred = model.predict(X_test)\n",
    "    print(y_pred)\n",
    "    cm = confusion_matrix(y_test, y_pred, labels=['VZ', 'TZ', 'WZ'])\n",
    "    \n",
