////////////////////// All the processes start here ///////////////////////////\
// Loop through each year in the range\
for (var year = startYear; year <= endYear; year++) \{\
  // Dynamically calculate startdate and enddate for the current year\
  var startdate = (year - 1).toString() + '-12-01';\
  var enddate = year.toString() + '-03-31';\
\
  // Print the year and corresponding dates\
  print('Year:', year, 'Start Date:', startdate, 'End Date:', enddate);\
\
  // Conditional logic for selecting Landsat datasets\
  var imagets;\
  if (whichls == 8) \{\
    imagets = L8_SR.filterDate(startdate, enddate)\
             .filterBounds(wzpoint1)\
             .map(maskL8)\
             .map(add3_L8)\
             .select(['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
  \} else if (whichls == 7) \{\
    imagets = L7_SR.filterDate(startdate, enddate)\
             .filterBounds(wzpoint1)\
             .map(maskL7)\
             .map(add3_L7)\
             .map(fillGaps)\
             .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
  \} else \{\
    imagets = L5_SR.filterDate(startdate, enddate)\
             .filterBounds(wzpoint1)\
             .map(maskL5)\
             .map(add3_L5)\
             .map(fillGaps)\
             .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
  \}\
\
  // Compute the median composite for the current year\
  var medianComposite = imagets.median();\
  print('Median Composite for Year', year, medianComposite);\
\
  // Extract values from the median composite\
  var extractMedianValues = medianComposite.reduceRegions(\{\
    collection: wzpoint1,         // Use the FeatureCollection of points\
    reducer: ee.Reducer.mean(),   // Use mean reducer (works as single value per band for a composite)\
    scale: 30                     // Landsat resolution\
  \});\
\
  // Print the extracted values for the current year\
  print('Extracted Values for Year', year, extractMedianValues);\
\
  // Export the results as a CSV to Google Drive for the current year\
  Export.table.toDrive(\{\
    collection: extractMedianValues, \
    //description: 'points_' + year.toString(),\
    description: 'full_' + year.toString(),\
    fileFormat: 'CSV',\
    folder: 'GEE'  \
  \});\
\}\
