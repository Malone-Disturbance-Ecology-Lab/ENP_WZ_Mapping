\f0\fs24 \cf0 var RGB_VIS = \{min: 0, max: 0.3, gamma: 1.5, bands: ['B4', 'B3', 'B2']\};\
var ndviParams = \{min: -1, max: 1, palette: ['blue', 'white', 'green']\};\
\
var whichls = 7\
\
//var wzpoint1 = ee.FeatureCollection("projects/gee-groundwater-paul/assets/class2018_new");\
//var wzpoint1 = ee.FeatureCollection("projects/gee-groundwater-paul/assets/Nansha")\
\
var wzpoint1 = ee.FeatureCollection("projects/gee-groundwater-paul/assets/class_2009")\
\
var maskL8 = function (image) \{\
  // Bits 3 and 5 are cloud shadow and cloud, respectively.\
  var cloudShadowBitMask = (1 << 3);\
  var cloudsBitMask = (1 << 5);\
  // Get the pixel QA band.\
  var qa = image.select('QA_PIXEL');\
  // Both flags should be set to zero, indicating clear conditions.\
  var mask = qa.bitwiseAnd(cloudShadowBitMask).eq(0)\
                 .and(qa.bitwiseAnd(cloudsBitMask).eq(0));\
  //return image.updateMask(mask).divide(10000);\
  return image.updateMask(mask);\
\}\
\
var maskL7 = function (image) \{\
  // Bits 3 and 4 are cloud shadow and cloud, respectively, in Landsat 7.\
  var cloudShadowBitMask = (1 << 3);  // Cloud shadow is bit 3\
  var cloudsBitMask = (1 << 4);       // Cloud is bit 4\
\
  // Get the pixel QA band.\
  var qa = image.select('QA_PIXEL');\
  \
  // Both flags should be set to zero, indicating clear conditions.\
  var mask = qa.bitwiseAnd(cloudShadowBitMask).eq(0)\
                 .and(qa.bitwiseAnd(cloudsBitMask).eq(0));\
\
  return image.updateMask(mask);\
\};\
\
var maskL5 = function (image) \{\
  var cloudShadowBitMask = (1 << 3); // Bit 3: Cloud shadow\
  var cloudsBitMask = (1 << 5);      // Bit 5: Clouds\
  var snowBitMask = (1 << 4);        // Bit 4: Snow/Ice\
\
  // Select the 'pixel_qa' band.\
  var qa = image.select('QA_PIXEL');\
\
  // All flags should be set to zero, indicating clear conditions.\
  var mask = qa.bitwiseAnd(cloudShadowBitMask).eq(0)\
                 .and(qa.bitwiseAnd(cloudsBitMask).eq(0))\
                 .and(qa.bitwiseAnd(snowBitMask).eq(0)); // Exclude snow/ice\
\
  // Return the masked image.\
  return image.updateMask(mask);\
\};\
\
\
\
function add3_L8(image) \{\
  var ndvi = image.normalizedDifference(['SR_B5', 'SR_B4']); // Landsat 8\
  var ndmi = image.normalizedDifference(['SR_B5', 'SR_B6']); // Landsat 8\
  var savi = image.expression(\
                '1.5 * (NIR - RED) / (NIR + RED + 0.5)', \{\
                'NIR': image.select('SR_B5'),\
                'RED': image.select('SR_B4')\
                 \}); // Landsat 8\
  savi = savi.float();\
  return image.addBands(ndvi.rename('ndvi')).addBands(ndmi.rename('ndmi'))\
              .addBands(savi.rename('savi'));\
\}\
\
function add3_L7(image) \{\
  var ndvi = image.normalizedDifference(['SR_B4', 'SR_B3']); // Landsat 7\
  var ndmi = image.normalizedDifference(['SR_B4', 'SR_B5']); // Landsat 7\
  var savi = image.expression(\
                '1.5 * (NIR - RED) / (NIR + RED + 0.5)', \{\
                'NIR': image.select('SR_B4'),\
                'RED': image.select('SR_B3')\
                 \}); // Landsat 8\
  savi = savi.float();\
  return image.addBands(ndvi.rename('ndvi')).addBands(ndmi.rename('ndmi'))\
              .addBands(savi.rename('savi'));\
\}\
\
function add3_L5(image) \{\
  // Compute NDVI using Landsat 5 bands: NIR (B4) and RED (B3)\
  var ndvi = image.normalizedDifference(['SR_B4', 'SR_B3']); // Landsat 5\
  \
  // Compute NDMI using Landsat 5 bands: NIR (B4) and SWIR1 (B5)\
  var ndmi = image.normalizedDifference(['SR_B4', 'SR_B5']); // Landsat 5\
  \
  // Compute SAVI using Landsat 5 bands: NIR (B4) and RED (B3)\
  var savi = image.expression(\
                '1.5 * (NIR - RED) / (NIR + RED + 0.5)', \{\
                'NIR': image.select('SR_B4'),\
                'RED': image.select('SR_B3')\
                 \});\
  \
  // Convert SAVI to float\
  savi = savi.float();\
  \
  // Add NDVI, NDMI, and SAVI as new bands and return the image\
  return image.addBands(ndvi.rename('ndvi')).addBands(ndmi.rename('ndmi'))\
              .addBands(savi.rename('savi'));\
\}\
\
if (whichls == 8)\{\
  var imagets = L8_SR.filterBounds(wzpoint1)\
           .map(maskL8)\
           .map(add3_L8)\
           .select(['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
\} else if (whichls == 7) \{\
   var imagets = L7_SR.filterBounds(wzpoint1)\
           .map(maskL7)\
           .map(add3_L7)\
           .filterDate('2009-12-01', '2010-01-31') \
           .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
\} else \{\
  var imagets = L5_SR.filterBounds(wzpoint1)\
           .map(maskL5)\
           .map(add3_L5)\
           .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ndvi', 'ndmi', 'savi']);\
\}\
           \
var extractValues = function(image) \{\
  return image.reduceRegions(\{\
    collection: wzpoint1,        // Use the FeatureCollection of points\
    reducer: ee.Reducer.mean(),  // Use mean reducer to get average value at each point\
    scale: 30                    // Set scale according to Landsat resolution\
  \}).map(function(feature) \{\
    return feature.set('date', image.date().format('YYYY-MM-dd'));  // Add date to each feature\
  \});\
\};\
\
// Map the extraction function over the ImageCollection to get time series for each point\
var timeSeries = imagets.map(extractValues).flatten();\
\
// Print to console (for checking in smaller datasets)\
//print('Extracted spectral time series:', timeSeries);\
\
// Export the results to Google Drive as a CSV file\
print(timeSeries)\
Export.table.toDrive(\{\
  collection: timeSeries,\
  description: 'RevisedTimeSeries',\
  fileFormat: 'CSV'\
\});}
